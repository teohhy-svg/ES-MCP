# Elasticsearch connection
ELASTICSEARCH_URL=http://localhost:9200

# Choose one authentication mode.
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=change-me
# ELASTICSEARCH_API_KEY=base64-api-key

# TLS
# ELASTICSEARCH_CA_CERT_PATH=/path/to/http_ca.crt

# MCP transport
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000

# Safety defaults
ES_READ_ONLY=true
ES_ENABLE_WRITE_TOOLS=false
ES_ENABLE_DESTRUCTIVE_TOOLS=false
ES_INDEX_ALLOWLIST=*
ES_INDEX_DENYLIST=.*, .security*, .kibana*, .fleet*, .tasks, .async-search*
ES_MAX_RESULT_SIZE=100
ES_MAX_TIMEOUT_SECONDS=30
ES_REQUEST_TIMEOUT_SECONDS=10

# Observability defaults
ES_LOG_INDEX_PATTERN=logs-*
ES_SLOW_LOG_INDEX_PATTERN=

# Logging
ES_MCP_LOG_LEVEL=INFO
ES_MCP_LOG_FORMAT=json
